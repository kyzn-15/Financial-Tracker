{
  "name": "financial-tracker-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:dashboard-analytics": "set NODE_ENV=test&& set TURSO_DATABASE_URL=file:./db/dashboard-analytics.test.db&& node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:security": "node --test tests/securityHardening.test.js",
    "test:dashboard-analytics": "node --test tests/dashboardAnalytics.seed.test.js",
    "test:recycle-bin": "node --test tests/recycleBin.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "@libsql/client": "^0.17.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multer": "^2.2.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
